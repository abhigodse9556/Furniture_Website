PORT=4000
CLIENT_ORIGIN=http://localhost:3000
ADMIN_EMAIL=owner@example.com

# Path to the Firebase service account JSON downloaded from the console
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# Or paste the entire service account JSON as a single line:
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional override (defaults to <project_id>.appspot.com from the service account)
# FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
